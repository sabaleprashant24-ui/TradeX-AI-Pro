# ==================================================
# TradeX AI Pro v4.0
# Environment Variables Example
# ==================================================

# -------------------------
# Application
# -------------------------
APP_NAME=TradeX AI Pro
APP_VERSION=4.0
APP_ENV=development
DEBUG=False

# -------------------------
# Trading Mode
# -------------------------
TRADING_MODE=PAPER

# Available:
# PAPER
# LIVE

# -------------------------
# Angel One SmartAPI
# -------------------------
API_KEY=YOUR_API_KEY
CLIENT_CODE=YOUR_CLIENT_CODE
PASSWORD=YOUR_PASSWORD
TOTP_SECRET=YOUR_TOTP_SECRET

# -------------------------
# Database
# -------------------------
DATABASE_NAME=tradex.db

# -------------------------
# Scanner
# -------------------------
AUTO_SCAN=True
SCAN_INTERVAL=60

# -------------------------
# Risk Management
# -------------------------
CAPITAL=5000
RISK_PER_TRADE=2
MAX_DAILY_LOSS=500
MAX_OPEN_TRADES=3

# -------------------------
# Strategy
# -------------------------
DEFAULT_STRATEGY=Hero Zero

# -------------------------
# Market
# -------------------------
EXCHANGE=NSE

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=INFO
LOG_FILE=tradex.log

# -------------------------
# Dashboard
# -------------------------
REFRESH_INTERVAL=5

# Seconds

# -------------------------
# Notifications
# -------------------------
ENABLE_NOTIFICATIONS=False

# Future
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL=
# SMTP_SERVER=

# ==================================================
# End
# ==================================================